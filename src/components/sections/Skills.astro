---
import SectionHead from '../ui/SectionHead.astro';
import ToolLogo from '../ui/ToolLogo.astro';
import { ui, type Lang } from '../../i18n';
import { getToolGroups } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const all = await getToolGroups(lang);
// Technologies (3 columns, logos) vs. working habits (one wide list below).
const stacks = all.filter((g) => g.id !== 'practice');
const practice = all.find((g) => g.id === 'practice');
---
<section class="section" id="skills">
  <div class="container split">
    <SectionHead title={t.skillsTitle} intro={t.skillsIntro} />
    <div class="skills">
      <div class="stacks">
        {stacks.map((g) => (
          <div class="group">
            <h3>{g.title}</h3>
            <ul class="tech">
              {g.items.filter((i) => !i.concept).map((item) => (
                <li>{item.logo ? <ToolLogo logo={item.logo} dark={item.logoDark} size={18} /> : <span class="gap" aria-hidden="true"></span>}<span>{item.name}</span></li>
              ))}
            </ul>
            <ul class:list={['plain', { 'plain--icons': g.items.some((i) => i.concept && i.logo) }]}>
              {g.items.filter((i) => i.concept).map((item) => (
                <li>{item.logo && <ToolLogo logo={item.logo} dark={item.logoDark} size={16} />}<span>{item.name}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      {practice && (
        <div class="practice">
          <h3>{practice.title}</h3>
          <ul>{practice.items.map((item) => <li>{item.name}</li>)}</ul>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .skills { display: grid; gap: clamp(2rem, 4vw, 3rem); align-content: start; }
  .stacks { display: grid; gap: 2.25rem 2rem; }
  @media (min-width: 640px) { .stacks { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .stacks { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .tech { margin-top: .6rem; }
  .tech li { display: grid; grid-template-columns: 18px minmax(0, 1fr); align-items: center; gap: .65rem; padding: .3rem 0; color: var(--muted); }
  .gap { width: 18px; height: 1px; }
  /* concepts (no logo): separated from the logo list, aligned to the group title */
  .plain { margin-top: .9rem; padding-top: .9rem; border-top: 1px solid var(--line); }
  .plain li { padding: var(--space-1) 0; color: var(--muted); font-size: .97rem; }
  .plain:empty { display: none; }
  .plain--icons li { display: grid; grid-template-columns: 16px minmax(0, 1fr); align-items: center; gap: .65rem; }

  .practice { padding-top: var(--space-5); border-top: 1px solid var(--line); }
  .practice ul { margin-top: .6rem; columns: 1; column-gap: var(--space-6); }
  @media (min-width: 640px) { .practice ul { columns: 2; } }
  .practice li { padding: var(--space-1) 0; color: var(--muted); break-inside: avoid; }
</style>
