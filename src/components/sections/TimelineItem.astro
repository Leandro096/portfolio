---
/** One entry of the experience list. Pass already-formatted strings. */
import Chips from '../ui/Chips.astro';
import type { ToolItem } from '../../lib/content';
interface Props { period: string; title: string; org: string; highlights: string[]; stack?: ToolItem[] }
const { period, title, org, highlights, stack = [] } = Astro.props;
---
<article class="t-item">
  <time>{period}</time>
  <div>
    <h3>{title}</h3>
    <p class="t-org">{org}</p>
    <ul>{highlights.map((h) => <li>{h}</li>)}</ul>
    {stack.length > 0 && <div class="t-stack"><Chips items={stack} /></div>}
  </div>
</article>

<style>
  time { display: block; color: var(--muted); font-family: var(--font-mono); font-size: var(--text-sm); margin-bottom: var(--space-2); }
  h3 { font-size: 1.35rem; letter-spacing: -.025em; }
  .t-org { margin-top: .15rem; color: var(--muted); }
  ul { margin-top: var(--space-4); display: grid; gap: .6rem; max-width: 66ch; }
  li { position: relative; padding-left: 1.1rem; }
  li::before { content: ""; position: absolute; left: 0; top: .7em; width: 6px; height: 1px; background: var(--muted); }
  .t-stack { margin-top: 1.1rem; }
  @media (min-width: 1100px) {
    .t-item { display: grid; grid-template-columns: 10rem minmax(0, 1fr); gap: var(--space-6); }
    time { margin: var(--space-2) 0 0; }
  }
</style>
