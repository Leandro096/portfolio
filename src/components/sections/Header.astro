---
import { Iconify } from "../iconify";
import LangSwitch from "../ui/LangSwitch.astro";
import Wordmark from "../ui/Wordmark.astro";
import { ui, type Lang } from "../../i18n";
import type { Profile } from "../../lib/content";

interface Props {
  lang: Lang;
  profile: Profile;
}
const { lang, profile } = Astro.props;
const t = ui[lang];

const links = [
  { id: "work", label: t.nav.work },
  { id: "skills", label: t.nav.skills },
  { id: "experience", label: t.nav.experience },
  { id: "contact", label: t.nav.contact },
];
---

<header class="site-header" id="header">
  <div class="container bar">
    <a
      class="brand"
      href="#top"
      aria-label={`${profile.name}, ${t.backToTopAria}`}
    >
      <Wordmark size="md" blink decorative />
    </a>

    <nav class="nav" id="nav" aria-label={t.primaryNav}>
      {links.map((l) => <a href={`#${l.id}`}>{l.label}</a>)}
    </nav>

    <div class="bar__actions">
      <LangSwitch lang={lang} />
      <button
        class="icon-btn theme-toggle"
        id="themeToggle"
        type="button"
        aria-label={t.switchTheme}
      >
        <Iconify class="i-sun" icon="solar:sun-linear" />
        <Iconify class="i-moon" icon="solar:moon-linear" />
      </button>
      <button
        class="icon-btn menu-btn"
        id="menuBtn"
        type="button"
        aria-label={t.openMenu}
        aria-expanded="false"
        aria-controls="nav"
        data-label-open={t.openMenu}
        data-label-close={t.closeMenu}
      >
        <Iconify class="i-menu" icon="solar:hamburger-menu-linear" />
        <Iconify class="i-close" icon="solar:close-linear" />
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 80;
    height: var(--header-h);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .nav {
    display: none;
    position: absolute;
    inset: 100% 0 auto 0;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    padding: var(--space-2) var(--gutter) var(--space-4);
  }
  .nav:global(.is-open) {
    display: grid;
  }
  .nav a {
    display: block;
    padding: 0.85rem 0;
    text-decoration: none;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
  }
  .nav a:hover,
  .nav a[aria-current="true"] {
    color: var(--text);
  }

  .bar__actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  @media (min-width: 900px) {
    .bar__actions {
      gap: var(--space-3);
    }
  }
  .theme-toggle :global(.i-sun) {
    display: none;
  }
  :global(html[data-theme="dark"]) .theme-toggle :global(.i-sun) {
    display: block;
  }
  :global(html[data-theme="dark"]) .theme-toggle :global(.i-moon) {
    display: none;
  }
  .menu-btn :global(.i-close) {
    display: none;
  }
  .menu-btn[aria-expanded="true"] :global(.i-close) {
    display: block;
  }
  .menu-btn[aria-expanded="true"] :global(.i-menu) {
    display: none;
  }

  @media (min-width: 900px) {
    .menu-btn {
      display: none;
    }
    .nav {
      display: flex;
      position: static;
      gap: 1.75rem;
      padding: 0;
      background: none;
      border: 0;
      align-items: center;
    }
    .nav a {
      border: 0;
      padding: 0.4rem 0;
      box-shadow: inset 0 -2px 0 transparent;
    }
    .nav a:hover {
      box-shadow: inset 0 -2px 0 var(--line-strong);
    }
    .nav a[aria-current="true"] {
      box-shadow: inset 0 -2px 0 var(--accent);
    }
  }
</style>
