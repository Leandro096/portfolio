---
/**
 * The whole page. Both /index.astro (EN) and /es/index.astro (ES) render this
 * component with a different `lang`. To add/remove/reorder sections, edit here.
 */
import Layout from '../../layouts/Layout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Projects from './Projects.astro';
import Skills from './Skills.astro';
import Experience from './Experience.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import { tr, ui, type Lang } from '../../i18n';
import { getProfile } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const profile = await getProfile();
const t = ui[lang];
---
<Layout lang={lang} title={`${profile.name} | ${tr(profile.role, lang)}`} description={tr(profile.description, lang)}>
  <a class="skip-link" href="#main">{t.skip}</a>

  <Header lang={lang} profile={profile} />
  <main id="main">
    <Hero lang={lang} profile={profile} />
    <Projects lang={lang} />
    <Skills lang={lang} />
    <Experience lang={lang} />
    <Contact lang={lang} profile={profile} />
  </main>
  <Footer lang={lang} profile={profile} />

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script>
    import '../../scripts/main';
  </script>
</Layout>

<style is:global>
  .skip-link {
    position: fixed; left: 1rem; top: -4rem; z-index: 100;
    background: var(--accent); color: var(--on-accent);
    padding: .7rem 1rem; border-radius: var(--r-md); font-weight: 600; text-decoration: none;
    transition: top .2s var(--ease);
  }
  .skip-link:focus { top: 1rem; }
</style>
