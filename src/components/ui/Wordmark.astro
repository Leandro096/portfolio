---
/**
 * Horizontal brand lockup: logo mark + "leangar" (display face) + ".dev" (mono, mint).
 * One definition for every place the brand is spelled out (header, footer).
 */
import Logo from "./Logo.astro";

interface Props {
  size?: "sm" | "md";
  blink?: boolean;
  /** Hide the text from assistive tech when the parent already carries an accessible name. */
  decorative?: boolean;
}
const { size = "md", blink = false, decorative = false } = Astro.props;
---

<span class:list={["wordmark", `wordmark--${size}`]}>
  <Logo size={size === "md" ? 34 : 22} blink={blink} />
  <span class="wordmark__name" aria-hidden={decorative ? "true" : undefined}
    >leangar<span class="wordmark__dev">.dev</span></span
  >
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--wm-gap);
  }
  .wordmark--md {
    --wm-gap: 0.6rem;
    --wm-size: 1.35rem;
  }
  .wordmark--sm {
    --wm-gap: 0.8rem;
    --wm-size: var(--text-md);
  }
  .wordmark__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--wm-size);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--text);
  }
  .wordmark__dev {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.92em;
    letter-spacing: -0.02em;
    color: var(--logo-cursor);
  }
</style>
